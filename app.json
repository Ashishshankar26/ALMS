{
  "expo": {
    "name": "ALMS",
    "slug": "lpu-app",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "alms",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#4C0099"
    },
    "ios": {
      "bundleIdentifier": "com.ashish.alms",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ashish.alms",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4C0099"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "ALMS",
      "shortName": "ALMS",
      "description": "ALMS student portal companion for timetable, attendance, results, fees, exams, and leave management.",
      "favicon": "./assets/images/favicon.png",
      "themeColor": "#4C0099",
      "backgroundColor": "#4C0099",
      "display": "standalone",
      "config": {
        "pwa": {
          "manifest": {
            "name": "ALMS - Student Portal",
            "short_name": "ALMS",
            "description": "Your premium university companion.",
            "start_url": "/",
            "display": "standalone",
            "background_color": "#4C0099",
            "theme_color": "#4C0099"
          }
        }
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4C0099"
        }
      ],
      "expo-web-browser",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "NextClassWidget",
              "label": "Next Class & Schedule",
              "minWidth": "110dp",
              "minHeight": "100dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "500dp",
              "maxResizeHeight": "650dp",
              "description": "View upcoming class, today's schedule timeline, and attendance stack on your home screen.",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "AttendanceWidget",
              "label": "Attendance Status",
              "minWidth": "110dp",
              "minHeight": "100dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "500dp",
              "maxResizeHeight": "650dp",
              "description": "Monitor your overall university attendance percentage and status.",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "QuickStatsWidget",
              "label": "Quick Stats",
              "minWidth": "110dp",
              "minHeight": "100dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "500dp",
              "maxResizeHeight": "650dp",
              "description": "Combined home screen widget showing your CGPA, attendance, and next class.",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d4673d8c-1de3-450a-bc76-184ac8280f88"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/d4673d8c-1de3-450a-bc76-184ac8280f88"
    },
    "runtimeVersion": "1.0.3"
  }
}
